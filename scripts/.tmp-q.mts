import { neon } from "@neondatabase/serverless";
import { leerCatalogo } from "@/lib/catalogo-costos-sql";
import { enlazarB2B, esB2BDeByte, limpiarNombreByte } from "@/lib/productos/precio-b2b-byte";
import { mesesB2B } from "@/lib/productos/precio-b2b-byte-sql";
const sql = neon(process.env.DATABASE_URL!);
const cat = await leerCatalogo(sql as any, 1);
const nombres = new Set<string>();
for (const m of mesesB2B(new Date(), 6)) for (const f of (await sql`SELECT DISTINCT product_name_raw n FROM rotacion_efectiva(1, ${m})`) as any[]) if (esB2BDeByte(f.n)) nombres.add(limpiarNombreByte(f.n).toUpperCase());
const prod = cat.efectivo.filter((i) => i.tipo === "producto").map((i) => ({ ref: i.ref, nombre: i.nombre }));
const ren = prod.map((p) => { const i = cat.efectivo.find((x) => x.ref === p.ref)!; return i.reemplaza === "AT-148" ? { ...p, nombre: "Pan de Hamburguesa" } : i.reemplaza === "AT-074" ? { ...p, nombre: "Pan de Hamburguesa Pequeño" } : p; });
const nom = (ref?: string) => ref ? prod.find((p) => p.ref === ref)!.nombre : "—";
const a = enlazarB2B([...nombres], prod), b = enlazarB2B([...nombres], ren);
for (const n of nombres) console.log(`${n.padEnd(48)} hoy: ${nom(a.get(n)).padEnd(40)} renombrado: ${nom(b.get(n))}`);
